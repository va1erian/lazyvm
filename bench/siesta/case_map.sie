// String case mapping as a game calls it every tick: short ASCII names,
// with and without a Locale (bench/bench/CaseMap.java).
package bench;
import java.util.Locale;

int rounds = 8000 * scale(args);
String[] words = {"Stone Pickaxe", "iron ore", "OAK PLANKS", "health: 10/10", "score", "Lava Bucket", "x", "MiXeD cAsE 123"};
long start = System.nanoTime();
long sum = 0;
for (int r = 0; r < rounds; r++) {
    for (int i = 0; i < words.length; i++) {
        var w = words[i];
        sum += w.toUpperCase().hashCode();
        sum += w.toLowerCase().hashCode();
        sum += w.toUpperCase(Locale.ENGLISH).length();
        sum += w.toLowerCase(Locale.ROOT).charAt(0);
        var same = w.toLowerCase();
        sum += same == w ? 1 : 0;
    }
}
report("casemap", sum, start);
