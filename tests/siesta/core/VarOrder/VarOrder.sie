// A top-level `var` is typed after the ones it uses, even from a file listed
// later. A lambda parameter hides a variable of its name only inside its
// lambda: `inc` and `count` are no cycle, and `scaled` still waits for `k`.
import java.util.function.IntUnaryOperator;

var doubled = ((IntUnaryOperator) (n -> n * 2)).applyAsInt(n);
var inc = (IntUnaryOperator) (count -> count + 1);
var count = inc.applyAsInt(doubled);
var scaled = ((IntUnaryOperator) (k -> k * 10)).applyAsInt(k);
System.out.println(doubled + " " + count + " " + scaled);
