System.out.println("Hello from Siesta");
int total = 0;
for (int i = 1; i <= 10; i++) {
    total += i;
}
System.out.println("sum " + total);
var words = ["lazy", "os", "siesta"];
for (var w : words) {
    System.out.println("${w} has ${w.length()} letters");
}
String greet(String who) {
    return "hi " + who;
}
System.out.println(greet("vm"));
