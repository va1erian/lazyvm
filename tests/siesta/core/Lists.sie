// List and map literals, generics, for-each, and the collection API.
import java.util.*;

var words = ["pear", "apple", "fig"];
List<Integer> nums = [3, 1, 2];
Map<String, Integer> ages = ["ann": 31, "bob": 25];
Map<String, List<String>> empty = [:];
System.out.println(words + " " + nums + " " + ages + " " + empty);
Collections.sort(words);
System.out.println(words);
int total = 0;
for (int x : nums) {
    total += x;
}
System.out.println(total);
for (var e : ages.entrySet()) {
    System.out.println(e.getKey() + " is " + e.getValue());
}
List<String> names = new ArrayList<>();
names.add("z");
names.add("y");
String first = names.get(0);
System.out.println(first + names.size());
Map<String, Integer> counts = new TreeMap<>();
for (var w : ["a", "b", "a", "c", "a"]) {
    counts.merge(w, 1, Integer::sum);
}
System.out.println(counts);
int[] arr = {5, 4, 3};
int[][] grid = new int[2][3];
grid[1][2] = 7;
System.out.println(arr.length + " " + arr[2] + " " + grid[1][2] + " " + Arrays.toString(arr));
StringBuilder sb = new StringBuilder()..append("cas")..append("cade");
System.out.println(sb);
