// String concatenation, templates and the methods of String.
var name = "Siesta";
int n = 3;
System.out.println("a" + 1 + 2 + " " + (1 + 2) + "b" + 'c' + 1.5 + true + null);
System.out.println("${name} has ${name.length()} letters and n*2 = ${n * 2}");
System.out.println("nested ${"inner ${n}"} and \$ dollar");
String s = "";
for (int i = 0; i < 3; i++) {
    s += i;
}
System.out.println(s + " " + s.length() + " " + "abc".toUpperCase() + " " + "a,b,c".split(",").length);
char[] cs = name.toCharArray();
System.out.println(cs[0] + " " + cs.length + " " + String.valueOf(cs, 1, 3));
StringBuilder sb = new StringBuilder();
sb.append("x").append(42).append('!');
System.out.println(sb);
System.out.println(n.toString() + 'z'.toString());
System.out.println("abc".equals("ab" + "c") + " " + "b".compareTo("a"));
