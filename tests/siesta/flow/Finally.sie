// `finally` on every way out: a return, break, continue and throw from the
// try block, from a catch block and from the finally block itself, nested
// finally blocks, and a finally that changes nothing a return already
// computed. Finally.java is its Java mirror.
var log = new StringBuilder();

void note(String s) { log.append(s).append(' '); }

int fromTry() {
    try { note("try"); return 1; } finally { note("fin"); }
}

int fromCatch() {
    try { throw new IllegalStateException("x"); }
    catch (IllegalStateException e) { note("catch"); return 2; }
    finally { note("fin"); }
}

int fromFinally() {
    try { note("try"); return 1; } finally { note("fin"); return 3; }
}

int computedFirst() {
    int x = 10;
    try { return x; } finally { x = 20; note("x=" + x); }
}

int loops() {
    int sum = 0;
    for (int i = 0; i < 5; i++) {
        try {
            if (i == 1) continue;
            if (i == 3) break;
            sum += i;
        } finally {
            note("f" + i);
        }
    }
    int j = 0;
    while (true) {
        try {
            try { j++; if (j == 2) break; }
            catch (RuntimeException e) { note("never"); }
            finally { note("in" + j); }
        } finally {
            note("out" + j);
        }
    }
    return sum * 10 + j;
}

String throws_(int where) {
    try {
        try {
            if (where == 0) throw new IllegalArgumentException("try");
            return "none";
        } catch (IllegalArgumentException e) {
            if (where == 0) throw new IllegalStateException("catch");
            return "unreached";
        } finally {
            note("fin" + where);
            if (where == 1) throw new UnsupportedOperationException("finally");
        }
    } catch (RuntimeException e) {
        return e.getClass().getSimpleName() + ":" + e.getMessage();
    }
}

String swallowed() {
    for (int i = 0; i < 2; i++) {
        try { throw new RuntimeException("lost"); }
        finally { note("drop" + i); continue; }
    }
    return "loop ended";
}

System.out.println(fromTry() + " " + fromCatch() + " " + fromFinally() + " " + computedFirst());
System.out.println(log);
log.setLength(0);
System.out.println(loops());
System.out.println(log);
log.setLength(0);
System.out.println(throws_(0) + " | " + throws_(1) + " | " + throws_(2));
System.out.println(log);
System.out.println(swallowed() + " " + log);
