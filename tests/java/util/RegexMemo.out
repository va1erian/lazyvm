== captures that a failed path leaves behind
#(?:a|a(?=(a)))*b len20: [16,20 13:14]
#(?:a|(a)(?=(a))a)*b len20: [16,20 -1:-1 13:14]
#(?:a|(?=(a))aa)*b len20: [16,20 13:14]
#(?:a|(?!(b))aa)*b len20: [16,20 19:20]
#(?:(?<=(a))a|aa)*b len20: [16,20 18:19]
#(?:a|(?>(a))a)*b len20: [16,20 13:14]
#(?:a|(a)++a)*b len20: [16,20 13:14]
#(?:a|a(?=(a)))*b len24: [20,24 17:18]
#(?:a|(a)(?=(a))a)*b len24: [20,24 -1:-1 17:18]
#(?:a|(?=(a))aa)*b len24: [20,24 17:18]
#(?:a|(?!(b))aa)*b len24: [20,24 23:24]
#(?:(?<=(a))a|aa)*b len24: [20,24 22:23]
#(?:a|(?>(a))a)*b len24: [20,24 17:18]
#(?:a|(a)++a)*b len24: [20,24 17:18]
== a counted loop: the same position fails with one count and succeeds with another
#(?:a|aa){3}b len23: [17,23]
#(?:a|aa){2,3}(?:b|$) len22: [17,22]
#(?:aa?){4}$ len24: [17,24]
#(?:a|aa){3}b len27: [21,27]
#(?:a|aa){2,3}(?:b|$) len26: [21,26]
#(?:aa?){4}$ len28: [21,28]
