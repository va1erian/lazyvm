== loops in lookarounds and inside loops
#(?<=(?:a(?>a?)){0,30}b)c len16: rejected
#(?<=(?:aa){0,30}b)c len16: [15,16]
#(?<=(?>a|aa){1,30})x len30: [14,15] [29,30]
#(?<!(?>aa|a){3,30}b)c len18: [17,18]
#(?=(?:a|aa)*b)a len19: [15,16] [16,17] [17,18]
#(?:a(?=(?:a|aa)*c)|a)*b len19: [15,19]
