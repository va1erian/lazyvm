#(?<=(?:aa){0,30}b)c len20: [19,20]
#(?<=(?>a|aa){1,30})x len38: [18,19] [37,38]
#(?<!(?>aa|a){3,30}b)c len22: [21,22]
#(?=(?:a|aa)*b)a len23: [19,20] [20,21] [21,22]
#(?:a(?=(?:a|aa)*c)|a)*b len23: [19,23]
