stream close during iteration: false
stream next at end: !java.util.NoSuchElementException
stream iterator remove: !java.lang.UnsupportedOperationException
walk: pre:. pre:a file:a/1.txt file:a/2.java pre:a/b file:a/b/3.txt pre:a/b/c file:a/b/c/4.txt post:a/b/c post:a/b pre:a/e post:a/e file:a/z.txt post:a pre:f file:f/5.java post:f file:g.txt file:h post:.
walk depth 0: dir:.
walk depth 1: pre:. dir:a dir:f file:g.txt file:h post:.
walk depth 2 from a: pre:a file:a/1.txt file:a/2.java pre:a/b file:a/b/3.txt dir:a/b/c post:a/b pre:a/e post:a/e file:a/z.txt post:a
