stream filter dirs: a f
stream empty dir: []
stream entries resolve against dir: true 5.java
stream missing: !java.nio.file.NoSuchFileException: <tmp>/nope
stream on file: !java.nio.file.NotDirectoryException: <tmp>/h
stream bad glob: PatternSyntaxException
stream iterator twice: !java.lang.IllegalStateException: Iterator already obtained
