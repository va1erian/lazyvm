async CompletionStage<Boolean> confirmDiscard() {
    if (!dirty) return true;
    switch (await Ui.ask("Save changes to ${title()}?", "Save", "Don't save", "Cancel")) {
        case 0 -> { return await save(); }
        case 1 -> { return true; }
        default -> { return false; }
    }
}

