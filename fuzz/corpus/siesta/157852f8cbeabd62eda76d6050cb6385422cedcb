async CompletionStage<Void> print(PrintJob job) {
    var printer = Messenger.connect(Print.class);
    printBar.visible(true);
    try {
        for (int page = 0; page < job.pages() && !cancelled; page++) {
            await, page.landscape) { on -> setLandscape(on); };
    };
};

